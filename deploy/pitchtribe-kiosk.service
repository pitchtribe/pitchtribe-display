[Unit]
Description=PitchTribe kiosk display (Chromium in cage on tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target pitchtribe.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pitchtribe-kiosk
EnvironmentFile=/etc/default/pitchtribe-kiosk
ExecStart=/usr/local/bin/pitchtribe-kiosk
Restart=always
RestartSec=5

# Give the kiosk a real logind seat session on tty1 so cage can use the
# display, GPU and input devices.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

# ---------------------------------------------------------------- hardening
# Kept deliberately light. The kiosk needs the GPU, the input devices and a
# seat on tty1, and Chromium brings its own sandbox for the web content, which
# is the part that handles anything untrusted. NoNewPrivileges, ProtectSystem
# and the namespace restrictions are left off on purpose: they interfere with
# Chromium's sandbox, and a mistake here is a black screen in a clubhouse.
# What follows is the subset that a browser on a seat has no use for.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical.target multi-user.target
