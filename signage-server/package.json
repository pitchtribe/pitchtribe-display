{
  "name": "pitchtribe-signage-server",
  "version": "1.0.0",
  "private": true,
  "description": "Collects sports fixtures, live scores and results and serves them to PitchTribe signage screens via HTTP API, live display page, webhooks and MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "mcp": "node src/mcp-stdio.js",
    "test": "node --test test/*.test.js",
    "six-metre": "node scripts/six-metre.js",
    "fulltime:capture": "node scripts/fulltime-capture.js",
    "preview": "node scripts/preview.js"
  },
  "main": "src/service.js",
  "exports": {
    ".": "./src/service.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "data",
    "config.example.json",
    "clubhouse.example.json"
  ]
}
